# Copy to .env at the repository root. Never commit .env.
# Generate a unique Django key and a local database password before starting.
DJANGO_SECRET_KEY=replace-with-a-long-random-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_DB=lead_followup
POSTGRES_USER=lead_followup
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_HOST=127.0.0.1
# Avoid ports used by other local databases.
POSTGRES_PORT=55432
# Production: set this explicitly to require or verify-full as appropriate.
POSTGRES_SSLMODE=disable
